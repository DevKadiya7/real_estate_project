# Copy to .env.local for local overrides. Both are optional — the dev
# server proxies /api to the backend by default (see vite.config.js).

# Base URL the browser calls directly (leave empty to use the Vite proxy).
VITE_API_BASE_URL=

# Only used by vite.config.js to pick the dev-server proxy target.
VITE_API_PROXY_TARGET=http://127.0.0.1:8010
