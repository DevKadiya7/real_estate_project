# Copy to .env and adjust as needed. Every value has a sane default in
# app/core/config.py, so .env is optional for local development.

APP_NAME="Gurgaon Real Estate API"
ENVIRONMENT=development
DEBUG=true

HOST=127.0.0.1
PORT=8010

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LOG_LEVEL=INFO

# Absolute or relative-to-backend path to the data directory. Defaults to
# <repo-root>/data.
# DATA_DIR=../data
